# ============================================================
# RideWise Environment Variables Example
# Copy values into your shell environment or a local .env file
# (never commit .env with real secrets).
# ============================================================

# ---- Backend: PostgreSQL ----
DATABASE_URL=jdbc:postgresql://localhost:5432/ridewise
DB_USERNAME=postgres
# Required when running against PostgreSQL (no default in application.properties)
DB_PASSWORD=change_me_postgres_password

# ---- Backend: Initial Platform Admin Bootstrap ----
# Seeded once on first boot if no ADMIN user exists.
# CHANGE THIS BEFORE EXPOSING YOUR SERVER PUBLICLY!
RIDEWISE_ADMIN_EMAIL=admin@ridewise.com
RIDEWISE_ADMIN_PASSWORD=ChangeMeToAStrongPassword!

# ---- Backend: CORS & WebSocket Allowed Origins (comma-separated) ----
# RIDEWISE_ALLOWED_ORIGINS=https://your-site.pages.dev,http://localhost:[*]

# ---- Backend: Optional SMTP / Gmail Feedback Alerts ----
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-app@gmail.com
# MAIL_PASSWORD=your-16-char-gmail-app-password
# RIDEWISE_ADMIN_ALERT_EMAIL=alerts@example.com

# ---- Backend: Sweepers & Session Timeouts (Spring Boot relaxed binding) ----
# RIDEWISE_FLEET_SESSION_TIMEOUT_MINUTES=30
# RIDEWISE_RIDES_AUTO_END_HOURS=48

# ---- Frontend: Optional Overrides ----
# Dev server proxy target only (frontend/vite.config.js):
# VITE_API_URL=http://localhost:8080
# Build-time WebSocket origin override baked into rideSocket.js & fleetSocket.js:
# VITE_WS_URL=wss://your-backend.example.com
